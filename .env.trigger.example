# Environment for the Trigger.dev workers. Fill in, then add to the project's
# environment variables in the Trigger.dev dashboard before deploying. The
# full variable matrix lives in docs/DEPLOYMENT.md.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

DATABASE_URL=

CLICKHOUSE_URL=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_READER_PASSWORD=
CLICKHOUSE_TELEMETRY_PASSWORD=

RESEND_API_KEY=
RENDER_TOKEN_SECRET=
RENDI_MODEL=claude-opus-4-8

# Must be the public app origin; screenshot and image tools persist absolute
# URLs built from it and fail fast in production without it.
RENDI_APP_URL=

GITHUB_TOKEN=

# DoorDash ordering (optional; leave unset to run without it). Deployed
# workers are headless: mint the token with `dd-cli export-token` on a
# machine where you are signed in. Approval codes are emailed to the owner
# address and nowhere else.
DD_CLI_ACCESS_TOKEN=
RENDI_OWNER_EMAIL=
DD_MAX_ORDER_CENTS=
DD_MAX_ORDERS_PER_DAY=
DD_MAX_APPROVALS_PER_DAY=
DD_HIDE_PERSONAL=
